<style>
  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 2rem;
  }

  aside {
    border-left: 1px solid #ddd;
    padding-left: 2rem;
  }

  @media (max-width: 700px) {
    .columns {
      grid-template-columns: 1fr;
    }

    aside {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid #ddd;
      padding-top: 2rem;
    }
  }
</style>
